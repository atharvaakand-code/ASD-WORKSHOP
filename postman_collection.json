{
  "info": {
    "name": "Razorpay Payment Backend (ASD Workshop 2)",
    "description": "Postman collection for testing Razorpay order creation, HMAC SHA256 payment verification, and webhook signature verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "razorpay_order_id",
      "value": "order_ExampleOrderId123",
      "type": "string"
    },
    {
      "key": "razorpay_payment_id",
      "value": "pay_ExamplePaymentId123",
      "type": "string"
    },
    {
      "key": "razorpay_signature",
      "value": "<64-char-hmac-sha256-hex-signature>",
      "type": "string"
    },
    {
      "key": "webhook_signature",
      "value": "<64-char-hmac-sha256-hex-signature>",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Checks whether the Express server is running."
      }
    },
    {
      "name": "Create Razorpay Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500,\n  \"currency\": \"INR\",\n  \"receipt\": \"order_rcpt_1001\",\n  \"notes\": {\n    \"course\": \"ASD Workshop 2\",\n    \"purpose\": \"Test order\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment/create-order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment",
            "create-order"
          ]
        },
        "description": "Creates a Razorpay order in Test Mode. 'amount' is in INR (e.g. 500 = INR 500 = 50000 paise)."
      }
    },
    {
      "name": "Verify Payment Signature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razorpay_order_id\": \"{{razorpay_order_id}}\",\n  \"razorpay_payment_id\": \"{{razorpay_payment_id}}\",\n  \"razorpay_signature\": \"{{razorpay_signature}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment",
            "verify"
          ]
        },
        "description": "Verifies Razorpay Checkout signature using HMAC SHA256 of 'razorpay_order_id|razorpay_payment_id' with RAZORPAY_KEY_SECRET."
      }
    },
    {
      "name": "Handle Razorpay Webhook",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-razorpay-signature",
            "value": "{{webhook_signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"entity\":\"event\",\"account_id\":\"acc_Example123\",\"event\":\"payment.captured\",\"contains\":[\"payment\"],\"payload\":{\"payment\":{\"entity\":{\"id\":\"pay_ExamplePaymentId123\",\"entity\":\"payment\",\"amount\":50000,\"currency\":\"INR\",\"status\":\"captured\",\"order_id\":\"order_ExampleOrderId123\"}}},\"created_at\":1700000000}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment/webhook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment",
            "webhook"
          ]
        },
        "description": "Verifies Razorpay webhook signature against the exact raw JSON body bytes using RAZORPAY_WEBHOOK_SECRET."
      }
    }
  ]
}
